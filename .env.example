# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ZOHO MAIL SMTP CONFIGURATION
# Required for sending automated order confirmation and admin notification emails strictly via Zoho Mail.

# ZOHO_MAIL_USER: Your full Zoho Mail address (e.g., orders@foger-vapes.store or your-account@zohomail.com)
ZOHO_MAIL_USER="orders@foger-vapes.store"

# ZOHO_MAIL_PASSWORD: Your Zoho Mail App Password (generated in Zoho Accounts > Security > App Passwords)
ZOHO_MAIL_PASSWORD="your-zoho-app-password"

# ZOHO_ADMIN_EMAIL: The email address where the store admin receives new order alerts (can be same as ZOHO_MAIL_USER or a specific admin inbox)
ZOHO_ADMIN_EMAIL="admin@foger-vapes.store"

# ZOHO_MAIL_HOST: Zoho SMTP server. Default is 'smtppro.zoho.com' (for custom domains) or 'smtp.zoho.com' (for @zoho.com accounts), or 'smtp.zoho.eu' (for European accounts)
ZOHO_MAIL_HOST="smtppro.zoho.com"

# ZOHO_MAIL_PORT: 465 (SSL, recommended) or 587 (TLS)
ZOHO_MAIL_PORT="465"

# ZOHO_MAIL_FROM_NAME: Friendly sender name shown to recipients
ZOHO_MAIL_FROM_NAME="Foger Vapes Store"
